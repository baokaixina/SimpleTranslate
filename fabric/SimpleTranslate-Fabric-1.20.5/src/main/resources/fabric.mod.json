{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/simple_translate/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.yourname.simpletranslate.SimpleTranslateServerMod"
    ],
    "client": [
      "com.yourname.simpletranslate.SimpleTranslateMod"
    ],
    "modmenu": [
      "com.yourname.simpletranslate.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "simple_translate.mixins.json"
  ],
  "accessWidener": "simple_translate.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.20.5 <1.20.6",
    "fabric-api": ">=0.95.1+1.20.5"
  },
  "suggests": {
    "modmenu": "*"
  }
}
